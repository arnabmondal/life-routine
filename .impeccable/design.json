      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A clear action with the shared focus treatment.",
      "html": "<button class=\"ds-primary\">New activity</button>",
      "css": ".ds-primary{font-family:Arial,Helvetica,sans-serif;font-size:13px;border:1px solid var(--green);border-radius:6px;min-height:40px;padding:8px 12px;cursor:pointer;transition:background-color .15s ease-out;background:var(--green);color:white}.ds-primary:hover{background:#195c49}.ds-primary:focus-visible{outline:3px solid var(--green,#23765e);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "A clear action with the shared focus treatment.",
      "html": "<button class=\"ds-outline\">Today</button>",
      "css": ".ds-outline{font-family:Arial,Helvetica,sans-serif;font-size:13px;border:1px solid var(--control);border-radius:6px;min-height:40px;padding:8px 12px;cursor:pointer;transition:background-color .15s ease-out;background:var(--surface);color:var(--ink)}.ds-outline:hover{background:var(--tonal)}.ds-outline:focus-visible{outline:3px solid var(--green,#23765e);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-outline{transition:none}}"
    },
    {
      "name": "Activity name field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label and comfortably sized editable text.",
      "html": "<label class=\"ds-label\">Activity name<input class=\"ds-input\" placeholder=\"Morning walk\"></label>",
      "css": ".ds-label{font:600 13px/1.5 Arial,Helvetica,sans-serif;color:var(--ink)}.ds-input{display:block;width:100%;max-width:300px;margin-top:6px;border:1px solid var(--control);border-radius:6px;background:var(--surface);color:var(--ink);padding:10px;min-height:44px;font:16px Arial,Helvetica,sans-serif}.ds-input:focus-visible{outline:3px solid var(--green,#23765e);outline-offset:3px}"
    },
    {
      "name": "Active navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Tonal selection within quiet navigation.",
      "html": "<button class=\"ds-nav\" aria-current=\"page\">My calendar</button>",
      "css": ".ds-nav{font:14px/1.5 Arial,Helvetica,sans-serif;background:var(--tonal);color:var(--ink);padding:12px;border:0;border-radius:8px;text-align:left;cursor:pointer}.ds-nav:hover{background:var(--tonal)}.ds-nav:focus-visible{outline:3px solid var(--green,#23765e);outline-offset:3px}"
    },
    {
      "name": "Weekly summary",
      "kind": "card",
      "refersTo": "summary",
      "description": "Representative sample values; compact regular-weight figures.",
      "html": "<div class=\"ds-summary\"><span>Completed</span><strong>8 <small>/ 12</small></strong></div>",
      "css": ".ds-summary{font:12px/1.5 Arial,Helvetica,sans-serif;background:var(--tonal);color:var(--muted);padding:16px;border-radius:12px}.ds-summary strong{display:block;color:var(--ink);font-size:28px;line-height:1.2;font-weight:400;margin-top:8px}.ds-summary small{font-size:16px;color:var(--muted)}"
    },
    {
      "name": "Activity card",
      "kind": "card",
      "refersTo": "event",
      "description": "A bordered commitment with time, category, and explicit outcome.",
      "html": "<article class=\"ds-event\"><button class=\"ds-edit\"><span>9:00 AM \u2013 9:30 AM</span><b>Morning walk</b><small><i></i>Health</small></button><div class=\"ds-outcome\">Planned</div></article>",
      "css": ".ds-event{max-width:220px;border:1px solid var(--line);border-radius:8px;background:var(--surface);overflow:hidden;font:12px/1.5 Arial,Helvetica,sans-serif;color:var(--muted)}.ds-edit{width:100%;padding:10px 8px 6px;text-align:left;background:transparent;border:0;color:inherit;font:inherit;cursor:pointer}.ds-edit b{display:block;color:var(--ink);font-size:13px;line-height:1.4;font-weight:600;margin:5px 0 8px}.ds-edit small{font-size:12px}.ds-edit i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:5px;background:#21a985}.ds-edit:hover{background:var(--tonal)}.ds-edit:focus-visible{outline:3px solid var(--green,#23765e);outline-offset:3px}.ds-outcome{padding:0 8px 8px}"
    }
