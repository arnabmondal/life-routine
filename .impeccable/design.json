  "narrative": {
    "northStar": "A Quiet Weekly Rhythm",
    "overview": "A quiet weekly rhythm: pale sage ground, a white working sheet, and clear green actions keep personal commitments easy to scan. The interface is supportive and practical, with compact summaries and space for an unplanned day.\n\nArial and Helvetica provide familiar, direct typography. Regular-weight headings and figures soften the dashboard without obscuring activity names, times, or outcomes. Colorful life-area dots preserve identity without taking over the calendar.",
    "keyCharacteristics": [
      "Pale sage ground and white working surfaces.",
      "Compact information with readable metadata.",
      "Green actions and small life-area color dots.",
      "Flat surfaces with restrained borders."
    ],
    "rules": [
      {
        "name": "The Small Dots Rule",
        "body": "Life-area colors identify categories through small dots; the working sheet remains neutral.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep activity times, titles, categories, and outcomes distinct.",
      "Do use the five life-area colors as small identity dots.",
      "Do retain visible keyboard focus and reduced-motion support.",
      "Do switch to a readable selected-day schedule on narrow screens."
    ],
    "donts": [
      "Don't introduce decorative imagery or entrance animation into this routine planner.",
      "Don't use life-area hues as large card fills.",
      "Don't shrink schedule metadata below the established 12px treatment."
    ]
  }
